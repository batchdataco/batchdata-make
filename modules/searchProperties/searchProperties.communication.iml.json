{
  "url": "/v1/property/search",
  "method": "POST",
  "body": {
    "searchCriteria": "{{omit(parameters, 'limit', 'skip')}}",
    "options": {
      "skip": "{{ifempty(parameters.skip, undefined)}}",
      "take": "{{min(100, ifempty(parameters.limit, 25))}}"
    }
  },
  "response": {
    "iterate": "{{body.results.properties}}",
    "output": {
      "{{...}}": "{{item}}",
      "searchMeta": "{{body.results.meta.results}}"
    },
    "limit": "{{ifempty(parameters.limit, 25)}}"
  },
  "pagination": {
    "body": {
      "searchCriteria": "{{omit(parameters, 'limit', 'skip')}}",
      "options": {
        "skip": "{{ifempty(parameters.skip, 0) + (pagination.page - 1) * 100}}",
        "take": "{{min(100, ifempty(parameters.limit, 25) - (pagination.page - 1) * 100)}}"
      }
    },
    "condition": "{{body.results.meta.results.resultsFound > ifempty(parameters.skip, 0) + (pagination.page - 1) * 100 && ifempty(parameters.limit, 25) > (pagination.page - 1) * 100}}"
  }
}
