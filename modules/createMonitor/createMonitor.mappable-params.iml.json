    "name": "additionalCriteria",
    "label": "Additional Criteria (JSON)",
    "help": "Optional JSON object merged into the search criteria. The fields above win on conflict. Callback URL keys are ignored. Optional JSON object with extra filters, for example {\"general\":{\"propertyTypeCategory\":{\"equals\":\"Single Family\"}}}. Fields you fill in above take priority.",
    "type": "text"
  },
  {
    "name": "deliveryType",
    "label": "Delivery Type",
    "required": true,
    "type": "select",
    "options": [
      {
        "label": "AWS Kinesis",
        "value": "kinesis"
      },
      {
        "label": "Azure Event Hub",
        "value": "event-hub"
      }
    ],
    "default": "kinesis"
  },
  {
    "name": "kinesis",
    "type": "collection",
    "label": "AWS Kinesis settings",
    "help": "Used when Delivery type is \"kinesis\".",
    "spec": [
      {
        "name": "streamName",
        "label": "Kinesis Stream Name",
        "type": "text"
      },
      {
        "name": "region",
        "label": "Kinesis AWS Region",
        "help": "For example us-west-2.",
        "type": "text"
      },
      {
        "name": "iamAccessKeyId",
        "label": "Kinesis IAM Access Key ID",
        "type": "text"
      },
      {
        "name": "iamSecretAccessKey",
        "label": "Kinesis IAM Secret Access Key",
        "type": "password"
      }
    ]
  },
  {
    "name": "eventHub",
    "type": "collection",
    "label": "Azure Event Hub settings",
    "help": "Used when Delivery type is \"event-hub\".",
    "spec": [
      {
        "name": "eventHubName",
        "label": "Event Hub Name",
        "type": "text"
      },
      {
        "name": "connectionString",
        "label": "Event Hub Connection String",
        "help": "Use this, or the namespace and service principal fields below.",
        "type": "password"
      },
      {
        "name": "fullyQualifiedNamespace",
        "label": "Event Hub Fully Qualified Namespace",
        "type": "text"
      },
      {
        "name": "clientId",
        "label": "Event Hub Client ID",
        "type": "text"
      },
      {
        "name": "tenantId",
        "label": "Event Hub Tenant ID",
        "type": "text"
      },
      {
        "name": "clientSecret",
        "label": "Event Hub Client Secret",
        "type": "password"
      }
    ]
  }
