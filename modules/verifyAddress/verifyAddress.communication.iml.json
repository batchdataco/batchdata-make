{
  "url": "/v1/address/verify",
  "method": "POST",
  "body": {
    "requests": [
      {
        "street": "{{parameters.street}}",
        "city": "{{ifempty(parameters.city, undefined)}}",
        "state": "{{ifempty(parameters.state, undefined)}}",
        "zip": "{{ifempty(parameters.zip, undefined)}}"
      }
    ]
  },
  "response": {
    "valid": {
      "condition": "{{if(body.results, true, false)}}",
      "type": "InvalidAccessTokenError",
      "message": "The BatchData API did not return a usable response. Check that the API token is valid. Contact support@batchservice.com if it still fails."
    },
    "output": "{{first(ifempty(body.results.addresses, emptyarray))}}"
  }
}
