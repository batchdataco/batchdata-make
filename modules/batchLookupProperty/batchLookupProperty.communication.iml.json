{
  "url": "/v1/property/lookup/all-attributes",
  "method": "POST",
  "body": {
    "requests": "{{parameters.addresses}}",
    "options": {
      "datasets": "{{if(length(parameters.datasets) > 0, parameters.datasets, undefined)}}"
    }
  },
  "response": {
    "output": {
      "properties": "{{body.results.properties}}",
      "matchCount": "{{body.results.meta.results.matchCount}}",
      "noMatchCount": "{{body.results.meta.results.noMatchCount}}"
    }
  }
}
