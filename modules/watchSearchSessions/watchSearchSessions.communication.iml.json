{
  "url": "/v2/property/search-sessions",
  "method": "GET",
  "response": {
    "iterate": "{{body.results.sessions}}",
    "output": "{{item}}",
    "trigger": {
      "type": "date",
      "date": "{{item.createdAt}}",
      "id": "{{item.id}}",
      "order": "unordered"
    },
    "limit": "{{ifempty(parameters.limit, 100)}}"
  },
  "qs": {
    "take": "{{min(100, ifempty(parameters.limit, 100))}}"
  },
  "pagination": {
    "qs": {
      "take": "{{min(100, ifempty(parameters.limit, 100) - (pagination.page - 1) * 100)}}",
      "skip": "{{0 + (pagination.page - 1) * 100}}"
    },
    "condition": "{{body.results.total > 0 + (pagination.page - 1) * 100 && ifempty(parameters.limit, 100) > (pagination.page - 1) * 100}}"
  }
}
