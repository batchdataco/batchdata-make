[
  {
    "name": "sessionId",
    "label": "Session ID",
    "required": true,
    "help": "Your own name for the session: letters, numbers, dash or underscore, up to 128 characters. Reusing the same ID continues the session, so you are never billed twice for the same property. A team can hold 100 sessions.",
    "type": "text",
    "validate": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  },
