{
  "url": "/v2/investor/properties",
  "method": "POST",
  "body": {
    "searchCriteria": {
      "investorId": "{{parameters.investorId}}",
      "ownership": "{{ifempty(parameters.ownership, undefined)}}",
      "includeChildEntities": "{{if(parameters.includeChildEntities == true, true, undefined)}}"
    },
    "options": {
      "take": "{{min(100, ifempty(parameters.limit, 25))}}",
      "pageCursor": "{{ifempty(parameters.pageCursor, undefined)}}"
    }
  },
  "response": {
    "iterate": "{{body.result.properties}}",
    "output": {
      "{{...}}": "{{item}}",
      "resultsFound": "{{body.result.resultsFound}}",
      "nextPageCursor": "{{body.result.nextPageCursor}}"
    },
    "limit": "{{ifempty(parameters.limit, 25)}}"
  },
  "pagination": {
    "body": {
      "searchCriteria": {
        "investorId": "{{parameters.investorId}}",
        "ownership": "{{ifempty(parameters.ownership, undefined)}}",
        "includeChildEntities": "{{if(parameters.includeChildEntities == true, true, undefined)}}"
      },
      "options": {
        "take": "{{min(100, ifempty(parameters.limit, 25) - (pagination.page - 1) * 100)}}",
        "pageCursor": "{{body.result.nextPageCursor}}"
      }
    },
    "condition": "{{length(ifempty(body.result.nextPageCursor, '')) > 0 && ifempty(parameters.limit, 25) > (pagination.page - 1) * 100}}"
  }
}
