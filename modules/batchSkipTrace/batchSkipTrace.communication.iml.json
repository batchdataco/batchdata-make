{
  "url": "/v3/property/skip-trace",
  "method": "POST",
  "body": {
    "requests": "{{parameters.properties}}",
    "options": {
      "includeTCPABlacklistedPhones": "{{if(parameters.includeTcpaFlagged == true, true, false)}}"
    }
  },
  "response": {
    "output": {
      "results": "{{body.result.data}}",
      "matchCount": "{{body.result.meta.results.matchCount}}",
      "requestCount": "{{body.result.meta.results.requestCount}}"
    }
  }
}
